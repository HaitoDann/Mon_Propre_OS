---
# Charte de l'installateur Calamares pour VinX OS.
componentName:  vinx

welcomeStyleCalamares:   false
welcomeExpandingLogo:    true
windowExpanding:    normal
windowSize: 920px,620px
windowPlacement: center
sidebar: widget
navigation: widget

strings:
    productName:         "VinX OS"
    shortProductName:    "VinX"
    version:             "0.1"
    shortVersion:        "0.1"
    versionedName:       "VinX OS 0.1"
    shortVersionedName:  "VinX 0.1"
    bootloaderEntryName: "VinX OS"
    productUrl:          "https://github.com/HaitoDann/VinX_OS"
    supportUrl:          "https://github.com/HaitoDann/VinX_OS/issues"
    knownIssuesUrl:      "https://github.com/HaitoDann/VinX_OS/issues"
    releaseNotesUrl:     "https://github.com/HaitoDann/VinX_OS"

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPI: 2

style:
   SidebarBackground:        "#121413"
   SidebarText:              "#ECECEE"
   SidebarTextCurrent:       "#06130D"
   SidebarBackgroundCurrent: "#10DD8C"
