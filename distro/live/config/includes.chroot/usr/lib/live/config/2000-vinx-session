#!/bin/sh
# live-config : la connexion automatique du live ouvre la session VinX OS.
# S'exécute après le composant sddm de live-config, qui écrit Session=plasma dans /etc/sddm.conf.
for f in /etc/sddm.conf /etc/sddm.conf.d/*.conf; do
	[ -f "$f" ] && grep -q '^Session=' "$f" && sed -i 's/^Session=.*/Session=vinx.desktop/' "$f"
done
exit 0
