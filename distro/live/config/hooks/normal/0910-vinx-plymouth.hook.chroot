#!/bin/sh
# Écran de démarrage : thème « vinx » dérivé du thème spinner (logo VinX au centre).
set -e
SRC=/usr/share/plymouth/themes/spinner
DST=/usr/share/plymouth/themes/vinx

for f in "$SRC"/*.png; do
	[ "$(basename "$f")" = watermark.png ] || cp "$f" "$DST/"
done

sed \
	-e 's/^Name=.*/Name=VinX OS/' \
	-e "s#^ImageDir=.*#ImageDir=$DST#" \
	-e 's/^BackgroundStartColor=.*/BackgroundStartColor=0x141517/' \
	-e 's/^BackgroundEndColor=.*/BackgroundEndColor=0x141517/' \
	-e 's/^WatermarkVerticalAlignment=.*/WatermarkVerticalAlignment=.42/' \
	"$SRC/spinner.plymouth" > "$DST/vinx.plymouth"

# Debian (desktop-base) déclare son propre thème « Debian 13 » via les alternatives,
# prioritaire sur plymouthd.conf : on y enregistre le thème VinX avec une priorité supérieure.
update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth "$DST/vinx.plymouth" 300
update-alternatives --set default.plymouth "$DST/vinx.plymouth"
plymouth-set-default-theme vinx
mkdir -p /etc/plymouth
printf '[Daemon]\nTheme=vinx\n' > /etc/plymouth/plymouthd.conf

# Le thème doit être intégré à l'image de démarrage (initramfs), sinon c'est celui de Debian
# qui s'affiche au démarrage.
update-initramfs -u -k all
