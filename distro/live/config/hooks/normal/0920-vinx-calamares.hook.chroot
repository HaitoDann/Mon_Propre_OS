#!/bin/sh
# Installateur Calamares : charte VinX, partitionnement, comptes, session par défaut.
# On modifie les fichiers de calamares-settings-debian clé par clé (sans les remplacer),
# pour rester compatible avec ses évolutions.
set -e
M=/etc/calamares/modules

# set_key FICHIER CLÉ VALEUR : remplace « clé: … » au premier niveau, ou l'ajoute.
set_key() {
	[ -f "$1" ] || return 0
	if grep -q "^$2:" "$1"; then
		sed -i "s|^$2:.*|$2: $3|" "$1"
	else
		printf '%s: %s\n' "$2" "$3" >> "$1"
	fi
}

if [ -f /etc/calamares/settings.conf ]; then
	sed -i 's/^branding:.*/branding: vinx/' /etc/calamares/settings.conf
fi

# Partitionnement : ext4, partition EFI de 512 Mio, chiffrement proposé, fichier d'échange.
# btrfs par défaut (ADR 0031) : instantanés instantanés et retour arrière depuis le menu de démarrage.
set_key $M/partition.conf defaultFileSystemType '"btrfs"'
set_key $M/partition.conf availableFileSystemTypes '["btrfs", "ext4", "xfs"]'
set_key $M/partition.conf enableLuksAutomatedPartitioning true
set_key $M/partition.conf userSwapChoices '[none, file]'
set_key $M/partition.conf initialSwapChoice file
set_key $M/partition.conf efiSystemPartitionSize 512M

# Sous-volumes btrfs attendus par Timeshift (@ et @home) ; fichier d'échange dans son propre sous-volume.
if [ -f $M/mount.conf ]; then
	sed -i '/^btrfsSubvolumes:/,/^[^ -]/{/^btrfsSubvolumes:/d;/^[ -]/d}' $M/mount.conf
	sed -i '/^btrfsSwapSubvol:/d' $M/mount.conf
	cat >> $M/mount.conf <<'MOUNT'
btrfsSubvolumes:
    - mountPoint: /
      subvolume: /@
    - mountPoint: /home
      subvolume: /@home
    - mountPoint: /var/cache
      subvolume: /@cache
    - mountPoint: /var/log
      subvolume: /@log
btrfsSwapSubvol: /@swap
MOUNT
fi

# Comptes : l'utilisateur créé est administrateur (sudo), pas de mot de passe root séparé.
set_key $M/users.conf setRootPassword false
set_key $M/users.conf doAutologin false
set_key $M/users.conf sudoersGroup sudo


# Session VinX par défaut sur le système installé.
if [ -f $M/displaymanager.conf ]; then
	sed -i '/^defaultDesktopEnvironment:/,/^[^ ]/{/^defaultDesktopEnvironment:/d;/^ /d}' $M/displaymanager.conf
	printf 'defaultDesktopEnvironment:\n    executable: "vinx-session"\n    desktopFile: "vinx"\n' >> $M/displaymanager.conf
fi

# Installation hors ligne (ADR 0022) : pendant l'installation, APT du système installé n'utilise
# que la clé (dépôt /pool de l'ISO) ; les sources réseau sont mises de côté puis rétablies
# (sources-final réécrit ensuite sources.list).
SM=/usr/sbin/sources-media
if [ -f $SM ] && ! grep -q vinx-off $SM; then
	sed -i '/^    umount \$CHROOT\/\$MEDIUM_PATH/a\
    for f in $CHROOT/etc/apt/sources.list.d/*.vinx-off; do [ -e "$f" ] \&\& mv "$f" "${f%.vinx-off}"; done\
    rm -f $CHROOT/etc/apt/sources.list.vinx-off' $SM
	sed -i '/^echo "deb \[trusted=yes\]/i\
[ -f $CHROOT/etc/apt/sources.list ] \&\& mv $CHROOT/etc/apt/sources.list $CHROOT/etc/apt/sources.list.vinx-off\
for f in $CHROOT/etc/apt/sources.list.d/*.list $CHROOT/etc/apt/sources.list.d/*.sources; do [ -e "$f" ] \&\& mv "$f" "$f.vinx-off"; done' $SM
fi

# Système installé : calamares-settings-debian retire ses réglages mais laisse le programme
# calamares (et son lanceur « Installer le système »). On ajoute calamares à la liste à retirer,
# sur le modèle de la ligne existante (même indentation, mêmes guillemets).
if [ -f $M/packages.conf ] && grep -q "calamares-settings-debian" $M/packages.conf \
	&& ! grep -Eq "^[[:space:]]*-[[:space:]]*['\"]?calamares['\"]?[[:space:]]*$" $M/packages.conf; then
	sed -i "/calamares-settings-debian/{p;s/calamares-settings-debian/calamares/}" $M/packages.conf
fi

# Renomme le raccourci « Install Debian » fourni par calamares-settings-debian.
for f in /usr/share/applications/*.desktop /etc/skel/Desktop/*.desktop; do
	[ -f "$f" ] && grep -q "Install Debian" "$f" && sed -i \
		-e 's/^Name=.*/Name=Installer VinX OS/' \
		-e 's/^Icon=.*/Icon=vinx-logo/' "$f"
done
exit 0
