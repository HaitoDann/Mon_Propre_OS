[Desktop Entry]
Type=Application
Name=Moniteur système
Name[en]=System Monitor
GenericName=Applications et ressources
GenericName[en]=Applications and resources
Comment=Voir ce qui occupe le processeur et la mémoire, fermer une application qui ne répond plus
Comment[en]=See what uses the processor and memory, close an application that stopped responding
Exec=vinx-monitor
Icon=utilities-system-monitor
Terminal=false
Categories=System;Monitor;
Keywords=moniteur;processus;tâches;gestionnaire;mémoire;processeur;fermer;bloqué;
Keywords[en]=monitor;process;task manager;memory;cpu;kill;frozen;
X-KDE-Shortcuts=Ctrl+Esc
