#!/bin/sh
# Session VinX OS : infrastructure Plasma (KWin, services, portails) avec le shell VinX
# à la place de plasmashell (cf. docs/adr/0009-session-vinx.md).
export VINX_SESSION=1
# Réglages propres à la session (KWin…), prioritaires sur ceux du système.
export XDG_CONFIG_DIRS="/usr/share/vinx/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"

# Touche Méta seule = recherche VinX. KWin la lit dans la configuration de l'utilisateur :
# on l'y écrit pour la durée de la session et on rétablit le comportement Plasma ensuite.
KWC=$(command -v kwriteconfig6 || true)
if [ -n "$KWC" ]; then
	"$KWC" --file kwinrc --group ModifierOnlyShortcuts --key Meta "org.vinx.Shell,/Shell,org.vinx.Shell,toggleSearch"
	# Pas d'écran de chargement KDE entre l'écran de connexion et le bureau VinX.
	"$KWC" --file ksplashrc --group KSplash --key Engine none
	"$KWC" --file ksplashrc --group KSplash --key Theme None
fi

/usr/bin/startplasma-wayland "$@"
status=$?

if [ -n "$KWC" ]; then
	"$KWC" --file kwinrc --group ModifierOnlyShortcuts --key Meta --delete
	"$KWC" --file ksplashrc --group KSplash --key Engine --delete
	"$KWC" --file ksplashrc --group KSplash --key Theme --delete
fi
exit $status
