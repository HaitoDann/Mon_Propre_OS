# Variante propre à la session (XDG_CURRENT_DESKTOP=KDE) : la spécification n'y autorise que
# [Default Applications] ; les associations ajoutées sont dans mimeapps.list.
[Default Applications]
inode/directory=org.vinx.files.desktop;org.kde.dolphin.desktop;

image/jpeg=org.vinx.images.desktop;org.kde.gwenview.desktop;
image/png=org.vinx.images.desktop;org.kde.gwenview.desktop;
image/webp=org.vinx.images.desktop;org.kde.gwenview.desktop;
image/gif=org.vinx.images.desktop;org.kde.gwenview.desktop;
image/bmp=org.vinx.images.desktop;org.kde.gwenview.desktop;
image/tiff=org.vinx.images.desktop;org.kde.gwenview.desktop;
image/svg+xml=org.vinx.images.desktop;org.kde.gwenview.desktop;
image/heic=org.vinx.images.desktop;org.kde.gwenview.desktop;
image/heif=org.vinx.images.desktop;org.kde.gwenview.desktop;
image/avif=org.vinx.images.desktop;org.kde.gwenview.desktop;
